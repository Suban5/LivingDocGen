<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>LivingDocGen.Reqnroll.Integration</PackageId>
    <Version>2.0.7</Version>
    <Authors>Suban Dhyako</Authors>
    <Description>Reqnroll integration for automatic living documentation generation. Self-contained - no global tool installation required!</Description>
    <PackageTags>BDD;Reqnroll;Living Documentation;Testing;SpecFlow</PackageTags>
    <PackageProjectUrl>https://github.com/suban5/LivingDocGen</PackageProjectUrl>
    <RepositoryUrl>https://github.com/suban5/LivingDocGen</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Reqnroll" Version="3.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LivingDocGen.Worker\LivingDocGen.Worker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  
  <ItemGroup>
    <!-- Copy ALL Worker output files (DLLs and runtime files) -->
    <Content Include="../LivingDocGen.Worker/bin/$(Configuration)/net8.0/LivingDocGen.Worker" 
             Condition="Exists('../LivingDocGen.Worker/bin/$(Configuration)/net8.0/LivingDocGen.Worker')"
             CopyToOutputDirectory="PreserveNewest" Link="LivingDocGen.Worker" />
    <Content Include="../LivingDocGen.Worker/bin/$(Configuration)/net8.0/LivingDocGen.Worker.dll"
             CopyToOutputDirectory="PreserveNewest" Link="LivingDocGen.Worker.dll" />
    <Content Include="../LivingDocGen.Worker/bin/$(Configuration)/net8.0/LivingDocGen.Worker.runtimeconfig.json"
             CopyToOutputDirectory="PreserveNewest" Link="LivingDocGen.Worker.runtimeconfig.json" />
    <Content Include="../LivingDocGen.Worker/bin/$(Configuration)/net8.0/LivingDocGen.Worker.deps.json"
             CopyToOutputDirectory="PreserveNewest" Link="LivingDocGen.Worker.deps.json" />
    <!-- Copy ALL dependency DLLs from Worker output -->
    <Content Include="../LivingDocGen.Worker/bin/$(Configuration)/net8.0/*.dll"
             Exclude="../LivingDocGen.Worker/bin/$(Configuration)/net8.0/LivingDocGen.Worker.dll"
             CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="IncludeWorkerFilesInPack" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <!-- Include ALL DLLs from Worker output in the NuGet package -->
      <_PackageFiles Include="$(OutputPath)*.dll" Exclude="$(OutputPath)LivingDocGen.Reqnroll.Integration.dll">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
        <Pack>true</Pack>
      </_PackageFiles>
      <_PackageFiles Include="$(OutputPath)LivingDocGen.Worker" Condition="Exists('$(OutputPath)LivingDocGen.Worker')">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
        <Pack>true</Pack>
      </_PackageFiles>
      <_PackageFiles Include="$(OutputPath)LivingDocGen.Worker.runtimeconfig.json">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
        <Pack>true</Pack>
      </_PackageFiles>
      <_PackageFiles Include="$(OutputPath)LivingDocGen.Worker.deps.json">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
        <Pack>true</Pack>
      </_PackageFiles>
    </ItemGroup>
  </Target>

</Project>
