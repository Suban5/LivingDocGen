{
  "$schema": "./schemas/bdd-livingdoc-schema.json",
  "enabled": true,
  "autoGenerate": "AfterTest",
  "paths": {
    "features": "./Features",
    "testResults": "./TestResults",
    "output": "./living-documentation.html"
  },
  "documentation": {
    "title": "My Project - Living Documentation",
    "theme": "purple",
    "primaryColor": "#9333ea"
  },
  "testResults": {
    "_comment": "Use 'format' shorthand OR 'patterns' array (not both)",
    "format": "trx",
    "_formatOptions": "trx | nunit | xunit | junit | specflow | all",
    "_patternsExample": ["*.trx", "*.xml", "*.json"]
  },
  "advanced": {
    "verbose": false,
    "includeSkipped": true,
    "includePending": true,
    "outputMode": "chunked"
  }
}
